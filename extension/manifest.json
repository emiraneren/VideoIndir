{
  "manifest_version": 3,
  "incognito": "spanning",
  "name": "VideoIndir",
  "version": "1.0.5",
  "description": "AÃ§Ä±k sekmedeki videoyu tek tÄ±kla istediÄŸin kalitede veya MP3 olarak indir.",
  "action": {
    "default_title": "Videoyu indir",
    "default_popup": "popup.html",
    "default_icon": { "16": "icon16.png", "48": "icon48.png", "128": "icon128.png" }
  },
  "icons": { "16": "icon16.png", "48": "icon48.png", "128": "icon128.png" },
