  "content_scripts": [
    { "matches": ["<all_urls>"], "js": ["hook.js"], "run_at": "document_start", "all_frames": true, "match_about_blank": true, "world": "MAIN" },
    { "matches": ["<all_urls>"], "js": ["relay.js"], "run_at": "document_start", "all_frames": true, "match_about_blank": true }
